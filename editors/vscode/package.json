{
  "name": "rusty-cpp-vscode",
  "displayName": "RustyCpp",
  "description": "VS Code integration for the RustyCpp C++ safety checker.",
  "version": "0.1.0",
  "publisher": "rusty-cpp",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "workspaceContains:**/*.cpp",
    "workspaceContains:**/*.c",
    "workspaceContains:**/*.h",
    "workspaceContains:**/*.hpp"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rustyCpp.restartLanguageServer",
        "title": "RustyCpp: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "RustyCpp",
      "properties": {
        "rustyCpp.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to a prebuilt rusty-cpp-lsp binary. If empty, the extension compiles tools/rusty-cpp-lsp.cpp."
        },
        "rustyCpp.lsp.checkerPath": {
          "type": "string",
          "default": "",
          "description": "Path to rusty-cpp-checker. If empty, the LSP server uses RUSTY_CPP_CHECKER or rusty-cpp-checker on PATH."
        },
        "rustyCpp.lsp.includePaths": {
          "type": "array",
          "default": [
            "${workspaceFolder}/include"
          ],
          "items": {
            "type": "string"
          },
          "description": "Include paths passed to rusty-cpp-checker."
        },
        "rustyCpp.lsp.defines": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Preprocessor defines passed to rusty-cpp-checker."
        },
        "rustyCpp.lsp.compileCommands": {
          "type": "string",
          "default": "",
          "description": "Path to compile_commands.json passed to rusty-cpp-checker."
        },
        "rustyCpp.lsp.compilerPath": {
          "type": "string",
          "default": "c++",
          "description": "C++ compiler used to build tools/rusty-cpp-lsp.cpp when serverPath is empty."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
