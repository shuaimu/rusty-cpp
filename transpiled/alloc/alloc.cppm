: _0(rusty::String::from_utf8_lossy(rusty::as_u8_slice(std::forward<Bytes>(bytes)))) {}
bool operator==(const Cow_Owned& other) const { return _0 == other._0; }
bool operator<(const Cow_Owned& other) const { return _0 < other._0; }
