            InPlaceDstDataSrcBufDrop(InPlaceDstDataSrcBufDrop&& other) noexcept : ptr(std::move(other.ptr)), len(std::move(other.len)), src_cap(std::move(other.src_cap)), src(std::move(other.src)) {
