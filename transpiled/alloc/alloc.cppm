            ~InPlaceDrop() noexcept(false) {
                if (_rusty_forgotten) { return; }
                // @unsafe
                {
                    rusty::ptr::drop_in_place(rusty::from_raw_parts_mut(this->inner, this->len()));
                }
            }
        };

