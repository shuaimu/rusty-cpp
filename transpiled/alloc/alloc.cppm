            }
        }
    };

}

namespace raw_vec {


    /// `Cap(cap)`, except if `T` is a ZST then `0usize`.
    ///
    /// # Safety: cap must be <= `isize::MAX`.
    // @unsafe
    template<typename T>
    Cap new_cap(size_t cap) {
        if constexpr ((rusty::mem::size_of<T>() == 0)) {
            return ZERO_CAP;
        } else {
            return std::move(cap);
        }
    }




}

