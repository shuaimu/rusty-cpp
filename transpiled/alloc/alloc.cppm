        struct InPlaceDrop {
            std::add_pointer_t<T> inner;
            std::add_pointer_t<T> dst;
            mutable bool _rusty_forgotten = false;
            InPlaceDrop(std::add_pointer_t<T> inner_init, std::add_pointer_t<T> dst_init) : inner(std::move(inner_init)), dst(std::move(dst_init)) {}
            InPlaceDrop(const InPlaceDrop&) = default;
            InPlaceDrop(InPlaceDrop&& other) noexcept : inner(std::move(other.inner)), dst(std::move(other.dst)) {
                this->_rusty_forgotten = other._rusty_forgotten;
                other._rusty_forgotten = true;
            }
            InPlaceDrop& operator=(const InPlaceDrop&) = default;
            InPlaceDrop& operator=(InPlaceDrop&& other) noexcept {
                if (this == &other) {
                    return *this;
                }
                this->~InPlaceDrop();
                new (this) InPlaceDrop(std::move(other));
                return *this;
            }
            void rusty_mark_forgotten() const noexcept { _rusty_forgotten = true; rusty::detail::mark_forgotten_if_supported(this->inner); rusty::detail::mark_forgotten_if_supported(this->dst); }


            size_t len() const {
                // @unsafe
                {
                    return this->dst->offset_from_unsigned(this->inner);
                }
