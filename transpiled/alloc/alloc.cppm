size_t len = lead < 0x80 ? 1 : (lead >> 5) == 0x6 ? 2 : (lead >> 4) == 0xE ? 3 : (lead >> 3) == 0x1E ? 4 : 0;
if (len == 0 || text.size() != len) {
return rusty::Result<T, rusty::String>::Err(rusty::String::from("too many characters in char"));
}
