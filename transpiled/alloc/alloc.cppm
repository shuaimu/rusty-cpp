                    // @unsafe
                    {
                        return *rusty::as_ptr(this->ptr);
                    }
                }
                const T& reborrow_shared() const {
                    // @unsafe
                    {
                        return *rusty::as_ptr(this->ptr);
                    }
                }
            };

