    template<typename T>
    struct RcInner {
        rusty::Cell<size_t> strong;
        rusty::Cell<size_t> weak;
        T value;
        [[no_unique_address]] alignas(2) rusty::Unit _rusty_align_anchor_{};

        const rusty::Cell<size_t>& weak_ref() const {
            return this->weak;
        }
        const rusty::Cell<size_t>& strong_ref() const {
            return this->strong;
        }
    };

    /// Helper type to allow accessing the reference counts without
    /// making any assertions about the data field.
    struct WeakInner {
        const rusty::Cell<size_t>& weak;
        const rusty::Cell<size_t>& strong;

        const rusty::Cell<size_t>& weak_ref() const;
        const rusty::Cell<size_t>& strong_ref() const;
    };

    namespace {
    class RcInnerPtr {
    public:
        virtual ~RcInnerPtr() noexcept(false) {}
        virtual const rusty::Cell<size_t>& weak_ref() const = 0;
        virtual const rusty::Cell<size_t>& strong_ref() const = 0;
        virtual size_t strong() const { return ([](auto&& __self) -> decltype(auto) { if constexpr (requires { rusty::detail::deref_if_pointer_like(std::forward<decltype(__self)>(__self)).strong_ref(); }) { return rusty::detail::deref_if_pointer_like(std::forward<decltype(__self)>(__self)).strong_ref(); } else if constexpr (requires { RcInnerPtr_::strong_ref(std::forward<decltype(__self)>(__self)); }) { return RcInnerPtr_::strong_ref(std::forward<decltype(__self)>(__self)); } else { return RcInnerPtr_::strong_ref(rusty::detail::deref_if_pointer_like(std::forward<decltype(__self)>(__self))); } })((*this)).get(); }
        virtual void inc_strong() const = 0;
        virtual void dec_strong() const = 0;
        virtual size_t weak() const { return ([](auto&& __self) -> decltype(auto) { if constexpr (requires { rusty::detail::deref_if_pointer_like(std::forward<decltype(__self)>(__self)).weak_ref(); }) { return rusty::detail::deref_if_pointer_like(std::forward<decltype(__self)>(__self)).weak_ref(); } else if constexpr (requires { RcInnerPtr_::weak_ref(std::forward<decltype(__self)>(__self)); }) { return RcInnerPtr_::weak_ref(std::forward<decltype(__self)>(__self)); } else { return RcInnerPtr_::weak_ref(rusty::detail::deref_if_pointer_like(std::forward<decltype(__self)>(__self))); } })((*this)).get(); }
        virtual void inc_weak() const = 0;
        virtual void dec_weak() const = 0;
        RcInnerPtr(const RcInnerPtr&) = delete;
        RcInnerPtr& operator=(const RcInnerPtr&) = delete;
        RcInnerPtr(RcInnerPtr&&) = delete;
        RcInnerPtr& operator=(RcInnerPtr&&) = delete;
    protected:
        RcInnerPtr() = default;
    };
    }

