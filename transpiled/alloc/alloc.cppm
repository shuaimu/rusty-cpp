if (len == 1) { code = lead; }
else {
code = lead & (0x7F >> len);
for (size_t k = 1; k < len; ++k) {
const unsigned char cont = static_cast<unsigned char>(text[k]);
if ((cont & 0xC0) != 0x80) {
