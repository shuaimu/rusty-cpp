            }
            return Weak<T, A>(this_.ptr, rusty::clone(this_.alloc));
        }
        UniqueArc<T, A> assume_init() {
            auto [ptr_shadow1, alloc] = rusty::detail::deref_if_pointer_like(std::remove_cvref_t<decltype((*this))>::into_inner_with_allocator(std::move((*this))));
            // @unsafe
            {
                return UniqueArc<T, A>::from_inner_in(ptr_shadow1.cast(), std::move(alloc));
            }
        }
        const T& operator*() const {
            // @unsafe
            {
                return this->ptr.as_ref().data;
            }
        }
        T& operator*() {
            // @unsafe
            {
                return (*rusty::as_ptr(this->ptr)).data;
            }
        }
