return &value;
}
template<typename T>
std::remove_reference_t<T>* addr_of_temp_mut(T&& value) {
if constexpr (std::is_lvalue_reference_v<T&&>) {
return &value;
} else {
/* Same full-expression-lifetime rationale as addr_of_temp above. */
return &value;
}
}
