// Cluster A completion: __TemplateArgs partial specializations
// for inner structs that participated in structural decomposition
// (so absorbed methods that referenced dropped impl-generics can
// recover them via `typename __TemplateArgs<HostParam>::arg_<N>`).
template<typename BorrowType, typename K, typename V, typename Type>
struct __TemplateArgs<::collections::btree::node::NodeRef<BorrowType, K, V, Type>> {
    using arg_0 = BorrowType;
    using arg_1 = K;
    using arg_2 = V;
    using arg_3 = Type;
};

// vec![x; n] support (SpecFromElem::from_elem out-of-line body)
template<typename T, typename A>
vec::Vec<T, A> SpecFromElem::from_elem(T elem, std::size_t n, A alloc) {
    auto v = vec::Vec<T, A>::with_capacity_in(n, std::move(alloc));
    for (std::size_t i = 0; i < n; ++i) v.push(rusty::clone(elem));
    return v;
}
