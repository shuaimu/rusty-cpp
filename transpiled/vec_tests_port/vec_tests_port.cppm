TEST_CASE("test_extend_from_within_out_of_rande") {
    bool rusty_should_panic_hit = false;
    try {
        auto v = vt_of(0, 1);
        v.extend_from_within(rusty::range_to(3));
    } catch (const std::exception& rusty_should_panic_ex) {
        rusty_should_panic_hit = true;
    }
    if (!rusty_should_panic_hit) { rusty::panic::do_panic("test did not panic as expected"); }
}

