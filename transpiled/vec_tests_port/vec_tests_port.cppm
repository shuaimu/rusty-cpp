TEST_CASE("test_pop_if") {
    auto v = vt_of(1, 2, 3, 4);
    const auto pred = [&](int32_t& x) { return (x % static_cast<int32_t>(2)) == static_cast<int32_t>(0); };
    if (!((v.pop_if(std::move(pred))) == (rusty::Option<int32_t>(4)))) { rusty::panic::do_panic("assertion failed: (v . pop_if (pred)) == (Some (4))"); }
    if (!(rusty::detail::deref_if_pointer_like((v)) == (std::array{1, 2, 3}))) { rusty::panic::do_panic("assertion failed: (v) == ([1 , 2 , 3])"); }
    if (!((v.pop_if(std::move(pred))) == rusty::detail::deref_if_pointer_like((rusty::None)))) { rusty::panic::do_panic("assertion failed: (v . pop_if (pred)) == (None)"); }
    if (!(rusty::detail::deref_if_pointer_like((v)) == (std::array{1, 2, 3}))) { rusty::panic::do_panic("assertion failed: (v) == ([1 , 2 , 3])"); }
}

TEST_CASE("test_pop_if_empty") {
    auto v = VecT<int32_t>::new_();
    if (!((v.pop_if([&](auto _closure_wild0) { return true; })) == rusty::detail::deref_if_pointer_like((rusty::None)))) { rusty::panic::do_panic("assertion failed: (v . pop_if (| _ | true)) == (None)"); }
    if (!(rusty::is_empty(v))) { rusty::panic::do_panic("assertion failed: v . is_empty ()"); }
}

TEST_CASE("test_pop_if_mutates") {
    auto v = vt_of(1);
    const auto pred = [&](int32_t& x) {
x += 1;
return false;
};
    if (!((v.pop_if(std::move(pred))) == rusty::detail::deref_if_pointer_like((rusty::None)))) { rusty::panic::do_panic("assertion failed: (v . pop_if (pred)) == (None)"); }
    if (!(rusty::detail::deref_if_pointer_like((v)) == (std::array{2}))) { rusty::panic::do_panic("assertion failed: (v) == ([2])"); }
}

