TEST_CASE("test_zip_unzip") {
    const auto z1 = vt_of(std::make_tuple(static_cast<int32_t>(1), static_cast<int32_t>(4)), std::make_tuple(static_cast<int32_t>(2), static_cast<int32_t>(5)), std::make_tuple(static_cast<int32_t>(3), static_cast<int32_t>(6)));
    auto&& _let_pat = vt_unzip(rusty::cloned(rusty::iter(z1)));
    auto&& left = rusty::detail::deref_if_pointer(std::get<0>(rusty::detail::deref_if_pointer(_let_pat)));
    auto&& right = rusty::detail::deref_if_pointer(std::get<1>(rusty::detail::deref_if_pointer(_let_pat)));
    if (!((std::make_tuple(1, 4)) == (std::make_tuple(left[static_cast<size_t>(0)], right[static_cast<size_t>(0)])))) { rusty::panic::do_panic("assertion failed: ((1 , 4)) == ((left [0] , right [0]))"); }
    if (!((std::make_tuple(2, 5)) == (std::make_tuple(left[static_cast<size_t>(1)], right[static_cast<size_t>(1)])))) { rusty::panic::do_panic("assertion failed: ((2 , 5)) == ((left [1] , right [1]))"); }
    if (!((std::make_tuple(3, 6)) == (std::make_tuple(left[static_cast<size_t>(2)], right[static_cast<size_t>(2)])))) { rusty::panic::do_panic("assertion failed: ((3 , 6)) == ((left [2] , right [2]))"); }
}

TEST_CASE("test_cmp") {
    const std::span<const ptrdiff_t> x = [&]() -> std::span<const ptrdiff_t> { static const std::array<ptrdiff_t, 5> _slice_ref_tmp = {static_cast<ptrdiff_t>(1), static_cast<ptrdiff_t>(2), static_cast<ptrdiff_t>(3), static_cast<ptrdiff_t>(4), static_cast<ptrdiff_t>(5)}; return std::span<const ptrdiff_t>(_slice_ref_tmp); }();
    const std::span<const ptrdiff_t> cmp = [&]() -> std::span<const ptrdiff_t> { static const std::array<ptrdiff_t, 5> _slice_ref_tmp = {static_cast<ptrdiff_t>(1), static_cast<ptrdiff_t>(2), static_cast<ptrdiff_t>(3), static_cast<ptrdiff_t>(4), static_cast<ptrdiff_t>(5)}; return std::span<const ptrdiff_t>(_slice_ref_tmp); }();
    if (!(rusty::slice_full(x) == rusty::detail::deref_if_pointer_like((cmp)))) { rusty::panic::do_panic("assertion failed: (& x [..]) == (cmp)"); }
    const std::span<const ptrdiff_t> cmp_shadow1 = [&]() -> std::span<const ptrdiff_t> { static const std::array<ptrdiff_t, 3> _slice_ref_tmp = {static_cast<ptrdiff_t>(3), static_cast<ptrdiff_t>(4), static_cast<ptrdiff_t>(5)}; return std::span<const ptrdiff_t>(_slice_ref_tmp); }();
    if (!(rusty::slice_from(x, 2) == rusty::detail::deref_if_pointer_like((cmp_shadow1)))) { rusty::panic::do_panic("assertion failed: (& x [2 ..]) == (cmp)"); }
    const std::span<const ptrdiff_t> cmp_shadow2 = [&]() -> std::span<const ptrdiff_t> { static const std::array<ptrdiff_t, 3> _slice_ref_tmp = {static_cast<ptrdiff_t>(1), static_cast<ptrdiff_t>(2), static_cast<ptrdiff_t>(3)}; return std::span<const ptrdiff_t>(_slice_ref_tmp); }();
    if (!(rusty::slice_to(x, 3) == rusty::detail::deref_if_pointer_like((cmp_shadow2)))) { rusty::panic::do_panic("assertion failed: (& x [.. 3]) == (cmp)"); }
    const std::span<const ptrdiff_t> cmp_shadow3 = [&]() -> std::span<const ptrdiff_t> { static const std::array<ptrdiff_t, 3> _slice_ref_tmp = {static_cast<ptrdiff_t>(2), static_cast<ptrdiff_t>(3), static_cast<ptrdiff_t>(4)}; return std::span<const ptrdiff_t>(_slice_ref_tmp); }();
    if (!(rusty::slice(x, 1, 4) == rusty::detail::deref_if_pointer_like((cmp_shadow3)))) { rusty::panic::do_panic("assertion failed: (& x [1 .. 4]) == (cmp)"); }
    const VecT<ptrdiff_t> x_shadow1 = vt_of_t<ptrdiff_t>(1, 2, 3, 4, 5);
    const std::span<const ptrdiff_t> cmp_shadow4 = [&]() -> std::span<const ptrdiff_t> { static const std::array<ptrdiff_t, 5> _slice_ref_tmp = {static_cast<ptrdiff_t>(1), static_cast<ptrdiff_t>(2), static_cast<ptrdiff_t>(3), static_cast<ptrdiff_t>(4), static_cast<ptrdiff_t>(5)}; return std::span<const ptrdiff_t>(_slice_ref_tmp); }();
    if (!(rusty::slice_full(x_shadow1) == rusty::detail::deref_if_pointer_like((cmp_shadow4)))) { rusty::panic::do_panic("assertion failed: (& x [..]) == (cmp)"); }
    const std::span<const ptrdiff_t> cmp_shadow5 = [&]() -> std::span<const ptrdiff_t> { static const std::array<ptrdiff_t, 3> _slice_ref_tmp = {static_cast<ptrdiff_t>(3), static_cast<ptrdiff_t>(4), static_cast<ptrdiff_t>(5)}; return std::span<const ptrdiff_t>(_slice_ref_tmp); }();
    if (!(rusty::slice_from(x_shadow1, 2) == rusty::detail::deref_if_pointer_like((cmp_shadow5)))) { rusty::panic::do_panic("assertion failed: (& x [2 ..]) == (cmp)"); }
    const std::span<const ptrdiff_t> cmp_shadow6 = [&]() -> std::span<const ptrdiff_t> { static const std::array<ptrdiff_t, 3> _slice_ref_tmp = {static_cast<ptrdiff_t>(1), static_cast<ptrdiff_t>(2), static_cast<ptrdiff_t>(3)}; return std::span<const ptrdiff_t>(_slice_ref_tmp); }();
    if (!(rusty::slice_to(x_shadow1, 3) == rusty::detail::deref_if_pointer_like((cmp_shadow6)))) { rusty::panic::do_panic("assertion failed: (& x [.. 3]) == (cmp)"); }
    const std::span<const ptrdiff_t> cmp_shadow7 = [&]() -> std::span<const ptrdiff_t> { static const std::array<ptrdiff_t, 3> _slice_ref_tmp = {static_cast<ptrdiff_t>(2), static_cast<ptrdiff_t>(3), static_cast<ptrdiff_t>(4)}; return std::span<const ptrdiff_t>(_slice_ref_tmp); }();
    if (!(rusty::slice(x_shadow1, 1, 4) == rusty::detail::deref_if_pointer_like((cmp_shadow7)))) { rusty::panic::do_panic("assertion failed: (& x [1 .. 4]) == (cmp)"); }
}

TEST_CASE("test_vec_truncate_drop") {
    auto v = vt_of(Elem_L550(static_cast<int32_t>(1)), Elem_L550(static_cast<int32_t>(2)), Elem_L550(static_cast<int32_t>(3)), Elem_L550(static_cast<int32_t>(4)), Elem_L550(static_cast<int32_t>(5)));
