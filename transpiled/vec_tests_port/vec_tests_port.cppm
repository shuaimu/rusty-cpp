TEST_CASE("test_drain_max_vec_size") {
    auto v = VecT<rusty::Unit>::with_capacity(std::numeric_limits<size_t>::max());
    // @unsafe
    {
        v.set_len(std::numeric_limits<size_t>::max());
    }
    for (auto&& _ : rusty::for_in(v.drain(rusty::range_from(rusty::detail::deref_if_pointer_like(std::numeric_limits<size_t>::max()) - 1)))) {
    }
    if (!((rusty::len(v)) == ((rusty::detail::deref_if_pointer_like(std::numeric_limits<size_t>::max()) - 1)))) { rusty::panic::do_panic("assertion failed: (v . len ()) == (usize :: MAX - 1)"); }
    auto v_shadow1 = VecT<rusty::Unit>::with_capacity(std::numeric_limits<size_t>::max());
    // @unsafe
    {
        v_shadow1.set_len(std::numeric_limits<size_t>::max());
