void assert_covariance() {
    const rusty::SafeFn<rusty::port::vec::Drain<std::string_view>(rusty::port::vec::Drain<std::string_view>)> drain = +[](rusty::port::vec::Drain<std::string_view> d) -> rusty::port::vec::Drain<std::string_view> {
        return std::move(d);
    };
    const rusty::SafeFn<rusty::port::vec::IntoIter<std::string_view>(rusty::port::vec::IntoIter<std::string_view>)> into_iter = +[](rusty::port::vec::IntoIter<std::string_view> i) -> rusty::port::vec::IntoIter<std::string_view> {
        return std::move(i);
    };
}

