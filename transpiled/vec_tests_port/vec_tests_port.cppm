/// This assortment of tests, in combination with miri, verifies we handle UB on fishy arguments
/// in the stdlib. Draining and extending the allocation are fairly well-tested earlier, but
/// `vec.insert(usize::MAX, val)` once slipped by!
///
/// All code that manipulates the collection types should be tested with "trivially wrong" args.
TEST_CASE("max_dont_panic") {
    auto v = vt_of(0);
    static_cast<void>(rusty::get(v, std::numeric_limits<size_t>::max()));
    v.shrink_to(std::numeric_limits<size_t>::max());
    v.truncate(std::numeric_limits<size_t>::max());
}

TEST_CASE("max_insert") {
    bool rusty_should_panic_hit = false;
    try {
        auto v = vt_of(0);
        v.insert(std::numeric_limits<size_t>::max(), 1);
    } catch (const std::exception& rusty_should_panic_ex) {
        rusty_should_panic_hit = true;
    }
    if (!rusty_should_panic_hit) { rusty::panic::do_panic("test did not panic as expected"); }
}

TEST_CASE("max_remove") {
    bool rusty_should_panic_hit = false;
    try {
        auto v = vt_of(0);
        v.remove(std::numeric_limits<size_t>::max());
    } catch (const std::exception& rusty_should_panic_ex) {
        rusty_should_panic_hit = true;
    }
    if (!rusty_should_panic_hit) { rusty::panic::do_panic("test did not panic as expected"); }
}

TEST_CASE("max_splice") {
    bool rusty_should_panic_hit = false;
    try {
        auto v = vt_of(0);
        v.splice(rusty::range_from(std::numeric_limits<size_t>::max()), rusty::once(1));
    } catch (const std::exception& rusty_should_panic_ex) {
        rusty_should_panic_hit = true;
    }
    if (!rusty_should_panic_hit) { rusty::panic::do_panic("test did not panic as expected"); }
}

TEST_CASE("max_swap_remove") {
    bool rusty_should_panic_hit = false;
    try {
        auto v = vt_of(0);
        v.swap_remove(std::numeric_limits<size_t>::max());
    } catch (const std::exception& rusty_should_panic_ex) {
        rusty_should_panic_hit = true;
    }
    if (!rusty_should_panic_hit) { rusty::panic::do_panic("test did not panic as expected"); }
}

