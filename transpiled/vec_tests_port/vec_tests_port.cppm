TEST_CASE("test_clone_from") {
    auto v = VecT<rusty::Box<int32_t>>::new_();
    const auto three = vt_of(rusty::Box<int32_t>::new_(1), rusty::Box<int32_t>::new_(2), rusty::Box<int32_t>::new_(3));
