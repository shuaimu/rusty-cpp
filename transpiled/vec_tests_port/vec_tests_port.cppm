    if (!(rusty::detail::deref_if_pointer_like((v)) == (vt_of(D_L822(static_cast<uint32_t>(0), false), D_L822(static_cast<uint32_t>(1), false), D_L822(static_cast<uint32_t>(6), false))))) { rusty::panic::do_panic("assertion failed: (v) == (vec ! [D_L822 (0 , false) , D_L822 (1 , false) , D_L822 (6 , false) ,])"); }
}

TEST_CASE("test_drain_keep_rest") {
    auto v = vt_of(0, 1, 2, 3, 4, 5, 6);
    auto drain = v.drain(rusty::range(1, 6));
    if (!((drain.next()) == (rusty::Option<int32_t>(1)))) { rusty::panic::do_panic("assertion failed: (drain . next ()) == (Some (1))"); }
    if (!((drain.next_back()) == (rusty::Option<int32_t>(5)))) { rusty::panic::do_panic("assertion failed: (drain . next_back ()) == (Some (5))"); }
    if (!((drain.next()) == (rusty::Option<int32_t>(2)))) { rusty::panic::do_panic("assertion failed: (drain . next ()) == (Some (2))"); }
    drain.keep_rest();
    if (!(rusty::detail::deref_if_pointer_like((v)) == std::array{0, 3, 4, 6})) { rusty::panic::do_panic("assertion failed: (v) == (& [0 , 3 , 4 , 6])"); }
}

