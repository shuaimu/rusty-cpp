    if (!((vt_next_chunk<2>(iter).unwrap()) == (std::array{static_cast<uint8_t>(108), static_cast<uint8_t>(111)}))) { rusty::panic::do_panic("assertion failed: (iter . next_chunk () . unwrap ()) == ([b'l' , b'o'])"); }
    if (!((vt_next_chunk<3>(iter).unwrap()) == (std::array{static_cast<uint8_t>(114), static_cast<uint8_t>(101), static_cast<uint8_t>(109)}))) { rusty::panic::do_panic("assertion failed: (iter . next_chunk () . unwrap ()) == ([b'r' , b'e' , b'm'])"); }
    if (!(((vt_next_chunk<4>(iter).unwrap_err()).as_slice()) == std::array<int, 0>{})) { rusty::panic::do_panic("assertion failed: (iter . next_chunk ::< 4 > () . unwrap_err () . as_slice ()) == (& [])"); }
}

