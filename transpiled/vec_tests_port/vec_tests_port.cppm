}

TEST_CASE("test_dedup") {
    const rusty::SafeFn<void(VecT<int32_t>, VecT<int32_t>)> case_ = +[](VecT<int32_t> a, VecT<int32_t> b) {
        auto v = std::move(a);
        v.dedup();
        if (!(rusty::detail::deref_if_pointer_like((v)) == rusty::detail::deref_if_pointer_like((b)))) { rusty::panic::do_panic("assertion failed: (v) == (b)"); }
    };
    case_(vt_of(), vt_of());
    case_(vt_of(1), vt_of(1));
    case_(vt_of(1, 1), vt_of(1));
    case_(vt_of(1, 2, 3), vt_of(1, 2, 3));
    case_(vt_of(1, 1, 2, 3), vt_of(1, 2, 3));
    case_(vt_of(1, 2, 2, 3), vt_of(1, 2, 3));
    case_(vt_of(1, 2, 3, 3), vt_of(1, 2, 3));
    case_(vt_of(1, 1, 2, 2, 2, 3, 3), vt_of(1, 2, 3));
}

TEST_CASE("test_dedup_by_key") {
    const rusty::SafeFn<void(VecT<int32_t>, VecT<int32_t>)> case_ = +[](VecT<int32_t> a, VecT<int32_t> b) {
        auto v = std::move(a);
        v.dedup_by_key([&](auto&& i) { return rusty::deref_mut(i) / 10; });
        if (!(rusty::detail::deref_if_pointer_like((v)) == rusty::detail::deref_if_pointer_like((b)))) { rusty::panic::do_panic("assertion failed: (v) == (b)"); }
    };
    case_(vt_of(), vt_of());
    case_(vt_of(10), vt_of(10));
    case_(vt_of(10, 11), vt_of(10));
    case_(vt_of(10, 20, 30), vt_of(10, 20, 30));
    case_(vt_of(10, 11, 20, 30), vt_of(10, 20, 30));
    case_(vt_of(10, 20, 21, 30), vt_of(10, 20, 30));
    case_(vt_of(10, 20, 30, 31), vt_of(10, 20, 30));
    case_(vt_of(10, 11, 20, 21, 22, 30, 31), vt_of(10, 20, 30));
}

