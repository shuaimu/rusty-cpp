}

TEST_CASE("test_retain") {
    auto vec = vt_of(1, 2, 3, 4);
    vec.retain([&](auto&& _closure_ref_param0) {
auto x = rusty::detail::deref_if_pointer_like(_closure_ref_param0);
return (rusty::detail::deref_if_pointer_like(x) % static_cast<int32_t>(2)) == static_cast<int32_t>(0);
});
    if (!(rusty::detail::deref_if_pointer_like((vec)) == (std::array{2, 4}))) { rusty::panic::do_panic("assertion failed: (vec) == ([2 , 4])"); }
}

TEST_CASE("test_retain_predicate_order") {
    for (auto&& to_keep : rusty::for_in(std::array{true, false})) {
        auto number_of_executions = 0;
        auto vec = vt_of(1, 2, 3, 4);
        auto next_expected = 1;
        vec.retain([&](auto&& _closure_ref_param0) {
auto x = rusty::detail::deref_if_pointer_like(_closure_ref_param0);
if (!(rusty::detail::deref_if_pointer_like((next_expected)) == rusty::detail::deref_if_pointer_like((x)))) { rusty::panic::do_panic("assertion failed: (next_expected) == (x)"); }
rusty::detail::deref_if_pointer_like(next_expected) += 1;
rusty::detail::deref_if_pointer_like(number_of_executions) += 1;
return std::move(to_keep);
});
        if (!(rusty::detail::deref_if_pointer_like((number_of_executions)) == (4))) { rusty::panic::do_panic("assertion failed: (number_of_executions) == (4)"); }
    }
}

TEST_CASE("test_retain_pred_panic_with_hole") {
    auto v = vt_from(rusty::collect_range(rusty::map((rusty::range(0, 5)), [](auto r) { return ::rusty::port::rc::Rc<int32_t>::new_(r); })));
    catch_unwind(AssertUnwindSafe([&]() {
auto v_shadow1 = rusty::clone(v);
v_shadow1.retain([&](auto&& r) { return [&]() -> bool { auto&& _m = rusty::detail::deref_if_pointer_like(rusty::deref_mut(r)); if (_m == 0) return true;
if (_m == 1) return false;
if (_m == 2) return true;
rusty::panic::do_panic("explicit panic"); }(); });
})).unwrap_err();
    if (!(rusty::all(rusty::iter(v), [&](auto&& r) { return ::rusty::port::rc::Rc<int32_t>::strong_count(r) == 1; }))) { rusty::panic::do_panic("assertion failed: v . iter () . all (| r | Rc :: strong_count (r) == 1)"); }
}

