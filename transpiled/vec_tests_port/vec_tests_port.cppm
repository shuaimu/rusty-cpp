    v.extend(std::array{1, 2});
    v.extend(vt_of(2, 3));
    v.extend(rusty::once(3));
    v.extend(rusty::empty<int32_t>());
    v.extend(rusty::filter(rusty::once(3), [&](auto _closure_wild0) { return true; }));
    v.extend(rusty::once(3));
    if (!((v0_shadow1) == (13))) { rusty::panic::do_panic("assertion failed: (* v0) == (13)"); }
