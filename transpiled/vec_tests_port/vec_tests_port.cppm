TEST_CASE("test_split_off") {
    auto vec = vt_of(1, 2, 3, 4, 5, 6);
    const auto orig_ptr = reinterpret_cast<const uint8_t*>(rusty::as_ptr(vec));
    const auto orig_capacity = vec.capacity();
    const auto split_off = vec.split_off(4);
    if (!(rusty::detail::deref_if_pointer_like((vec)) == (std::array{1, 2, 3, 4}))) { rusty::panic::do_panic("assertion failed: (vec) == ([1 , 2 , 3 , 4])"); }
    if (!(rusty::detail::deref_if_pointer_like((split_off)) == (std::array{5, 6}))) { rusty::panic::do_panic("assertion failed: (split_off) == ([5 , 6])"); }
    if (!((vec.capacity()) == rusty::detail::deref_if_pointer_like((orig_capacity)))) { rusty::panic::do_panic("assertion failed: (vec . capacity ()) == (orig_capacity)"); }
    if (!((reinterpret_cast<const uint8_t*>(rusty::as_ptr(vec))) == (orig_ptr))) { rusty::panic::do_panic("assertion failed: (vec . as_ptr ()) == (orig_ptr)"); }
}

TEST_CASE("test_split_off_take_all") {
    auto vec = VecT<int32_t>::with_capacity(1000);
    vec.extend(std::array{1, 2, 3, 4, 5, 6});
    const auto orig_ptr = reinterpret_cast<const int32_t*>(rusty::as_ptr(vec));
    const auto orig_capacity = vec.capacity();
    const auto split_off = vec.split_off(0);
    if (!(rusty::detail::deref_if_pointer_like((vec)) == (std::array<int, 0>{}))) { rusty::panic::do_panic("assertion failed: (vec) == ([])"); }
    if (!(rusty::detail::deref_if_pointer_like((split_off)) == (std::array{1, 2, 3, 4, 5, 6}))) { rusty::panic::do_panic("assertion failed: (split_off) == ([1 , 2 , 3 , 4 , 5 , 6])"); }
    if (!((vec.capacity()) == rusty::detail::deref_if_pointer_like((orig_capacity)))) { rusty::panic::do_panic("assertion failed: (vec . capacity ()) == (orig_capacity)"); }
    if (!((reinterpret_cast<const int32_t*>(rusty::as_ptr(vec))) == (orig_ptr))) { rusty::panic::do_panic("assertion failed: (vec . as_ptr ()) == (orig_ptr)"); }
    if (!(split_off.capacity() < rusty::detail::deref_if_pointer_like(orig_capacity))) { rusty::panic::do_panic("assertion failed: split_off . capacity () < orig_capacity"); }
    if (!((reinterpret_cast<const int32_t*>(rusty::as_ptr(split_off))) != (orig_ptr))) { rusty::panic::do_panic("assertion failed: (split_off . as_ptr ()) != (orig_ptr)"); }
}

TEST_CASE("test_into_iter_as_slice") {
    auto vec = vt_of(U'a', U'b', U'c');
    auto into_iter = std::move(vec).into_iter();
    if (!((rusty::as_slice(into_iter)) == std::array{U'a', U'b', U'c'})) { rusty::panic::do_panic("assertion failed: (into_iter . as_slice ()) == (& ['a' , 'b' , 'c'])"); }
    static_cast<void>(into_iter.next().unwrap());
    if (!((rusty::as_slice(into_iter)) == std::array{U'b', U'c'})) { rusty::panic::do_panic("assertion failed: (into_iter . as_slice ()) == (& ['b' , 'c'])"); }
    static_cast<void>(into_iter.next().unwrap());
    static_cast<void>(into_iter.next().unwrap());
    if (!((rusty::as_slice(into_iter)) == std::array<int, 0>{})) { rusty::panic::do_panic("assertion failed: (into_iter . as_slice ()) == (& [])"); }
}

