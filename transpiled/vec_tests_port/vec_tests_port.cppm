TEST_CASE("test_into_iter_advance_by") {
    auto i = (vt_of(1, 2, 3, 4, 5)).into_iter();
    if (!((i.advance_by(0)) == (rusty::Ok(std::make_tuple())))) { rusty::panic::do_panic("assertion failed: (i . advance_by (0)) == (Ok (()))"); }
    if (!((i.advance_back_by(0)) == (rusty::Ok(std::make_tuple())))) { rusty::panic::do_panic("assertion failed: (i . advance_back_by (0)) == (Ok (()))"); }
    if (!((rusty::as_slice(i)) == (std::array{1, 2, 3, 4, 5}))) { rusty::panic::do_panic("assertion failed: (i . as_slice ()) == ([1 , 2 , 3 , 4 , 5])"); }
    if (!((i.advance_by(1)) == (rusty::Ok(std::make_tuple())))) { rusty::panic::do_panic("assertion failed: (i . advance_by (1)) == (Ok (()))"); }
    if (!((i.advance_back_by(1)) == (rusty::Ok(std::make_tuple())))) { rusty::panic::do_panic("assertion failed: (i . advance_back_by (1)) == (Ok (()))"); }
    if (!((rusty::as_slice(i)) == (std::array{2, 3, 4}))) { rusty::panic::do_panic("assertion failed: (i . as_slice ()) == ([2 , 3 , 4])"); }
    if (!((i.advance_back_by(std::numeric_limits<size_t>::max())) == (rusty::Err(rusty::num::NonZero<size_t>::new_(rusty::detail::deref_if_pointer_like(std::numeric_limits<size_t>::max()) - 3).unwrap())))) { rusty::panic::do_panic("assertion failed: (i . advance_back_by (usize :: MAX)) == (Err (NonZero :: new (usize :: MAX - 3) . unwrap ()))"); }
    if (!((i.advance_by(std::numeric_limits<size_t>::max())) == (rusty::Err(rusty::num::NonZero<size_t>::new_(std::numeric_limits<size_t>::max()).unwrap())))) { rusty::panic::do_panic("assertion failed: (i . advance_by (usize :: MAX)) == (Err (NonZero :: new (usize :: MAX) . unwrap ()))"); }
    if (!((i.advance_by(0)) == (rusty::Ok(std::make_tuple())))) { rusty::panic::do_panic("assertion failed: (i . advance_by (0)) == (Ok (()))"); }
    if (!((i.advance_back_by(0)) == (rusty::Ok(std::make_tuple())))) { rusty::panic::do_panic("assertion failed: (i . advance_back_by (0)) == (Ok (()))"); }
    if (!((rusty::len(i)) == (0))) { rusty::panic::do_panic("assertion failed: (i . len ()) == (0)"); }
}

