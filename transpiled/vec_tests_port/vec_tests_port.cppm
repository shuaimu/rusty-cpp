explicit Cow_Borrowed(const Bytes& bytes)
requires (!std::is_convertible_v<Bytes, std::string_view>)
{
if constexpr (requires { bytes.data(); bytes.size(); }) {
const auto* raw = bytes.data();
const auto len = static_cast<std::size_t>(bytes.size());
_0 = std::string_view(reinterpret_cast<const char*>(raw), len);
} else if constexpr (requires { bytes.as_ref(); }) {
auto view = bytes.as_ref();
if constexpr (requires { view.data(); view.size(); }) {
const auto* raw = view.data();
const auto len = static_cast<std::size_t>(view.size());
_0 = std::string_view(reinterpret_cast<const char*>(raw), len);
} else {
_0 = std::string_view{};
}
} else {
_0 = std::string_view{};
}
