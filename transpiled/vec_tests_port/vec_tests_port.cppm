}

TEST_CASE("test_zero_sized_capacity") {
    for (auto&& len : rusty::for_in(std::array{0, 1, 2, 4, 8, 16, 32, 64, 128, 256})) {
        const auto v = VecT<rusty::Unit>::with_capacity(std::move(len));
        if (!((rusty::len(v)) == (0))) { rusty::panic::do_panic("assertion failed: (v . len ()) == (0)"); }
        if (!((v.capacity()) == rusty::detail::deref_if_pointer_like((std::numeric_limits<size_t>::max())))) { rusty::panic::do_panic("assertion failed: (v . capacity ()) == (usize :: MAX)"); }
    }
}

TEST_CASE("test_zero_sized_vec_push") {
    constexpr size_t N = static_cast<size_t>(8);
    for (auto&& len : rusty::for_in(rusty::range(0, N))) {
        auto tester = VecT<rusty::Unit>::with_capacity(std::move(len));
        if (!((rusty::len(tester)) == (0))) { rusty::panic::do_panic("assertion failed: (tester . len ()) == (0)"); }
        if (!(tester.capacity() >= rusty::detail::deref_if_pointer_like(len))) { rusty::panic::do_panic("assertion failed: tester . capacity () >= len"); }
        for (auto&& _ : rusty::for_in(rusty::range(0, len))) {
            tester.push(std::make_tuple());
        }
        if (!((rusty::len(tester)) == rusty::detail::deref_if_pointer_like((len)))) { rusty::panic::do_panic("assertion failed: (tester . len ()) == (len)"); }
        if (!((rusty::count(rusty::iter(tester))) == rusty::detail::deref_if_pointer_like((len)))) { rusty::panic::do_panic("assertion failed: (tester . iter () . count ()) == (len)"); }
        tester.clear();
    }
}

TEST_CASE("test_vec_macro_repeat") {
    if (!((vt_repeat(1, 3)) == (vt_of(1, 1, 1)))) { rusty::panic::do_panic("assertion failed: (vec ! [1 ; 3]) == (vec ! [1 , 1 , 1])"); }
    if (!((vt_repeat(1, 2)) == (vt_of(1, 1)))) { rusty::panic::do_panic("assertion failed: (vec ! [1 ; 2]) == (vec ! [1 , 1])"); }
    if (!((vt_repeat(1, 1)) == (vt_of(1)))) { rusty::panic::do_panic("assertion failed: (vec ! [1 ; 1]) == (vec ! [1])"); }
    if (!((vt_repeat(1, 0)) == (vt_of()))) { rusty::panic::do_panic("assertion failed: (vec ! [1 ; 0]) == (vec ! [])"); }
    const auto el = rusty::Box<int32_t>::new_(static_cast<int32_t>(1));
    auto n = 3;
    if (!((vt_repeat(el, n)) == (vt_of(rusty::Box<int32_t>::new_(1), rusty::Box<int32_t>::new_(1), rusty::Box<int32_t>::new_(1))))) { rusty::panic::do_panic("assertion failed: (vec ! [el ; n]) == (vec ! [Box :: new (1) , Box :: new (1) , Box :: new (1)])"); }
}

TEST_CASE("test_vec_swap") {
    VecT<ptrdiff_t> a = vt_of_t<ptrdiff_t>(0, 1, 2, 3, 4, 5, 6);
    [&]() { auto&& _swap_recv = a; auto&& _swap_view = _swap_recv; const auto _swap_i = 2; const auto _swap_j = 4; const auto _swap_len = rusty::len(_swap_view); if (!(_swap_i < _swap_len && _swap_j < _swap_len)) { rusty::panicking::panic("index out of bounds"); } rusty::mem::swap(_swap_view[_swap_i], _swap_view[_swap_j]); }();
    if (!((a[static_cast<size_t>(2)]) == (static_cast<ptrdiff_t>(4)))) { rusty::panic::do_panic("assertion failed: (a [2]) == (4)"); }
    if (!((a[static_cast<size_t>(4)]) == (static_cast<ptrdiff_t>(2)))) { rusty::panic::do_panic("assertion failed: (a [4]) == (2)"); }
    auto n = static_cast<ptrdiff_t>(42);
    rusty::mem::swap(n, a[static_cast<size_t>(0)]);
    if (!((a[static_cast<size_t>(0)]) == (static_cast<ptrdiff_t>(42)))) { rusty::panic::do_panic("assertion failed: (a [0]) == (42)"); }
    if (!(rusty::detail::deref_if_pointer_like((n)) == (0))) { rusty::panic::do_panic("assertion failed: (n) == (0)"); }
}

TEST_CASE("test_extend_from_within_clone") {
    auto v = vt_of(rusty::String::from("sssss"), rusty::String::from("12334567890"), rusty::String::from("c"));
    v.extend_from_within(rusty::range_from(1));
    if (!(rusty::detail::deref_if_pointer_like((v)) == (std::array{std::string_view("sssss"), std::string_view("12334567890"), std::string_view("c"), std::string_view("12334567890"), std::string_view("c")}))) { rusty::panic::do_panic("assertion failed: (v) == ([\"sssss\" , \"12334567890\" , \"c\" , \"12334567890\" , \"c\"])"); }
}

TEST_CASE("test_extend_from_within_complete_rande") {
