    inline void spec_extend(Vec&&, Iter&&) {
        // Real implementation lives in the spec_extend module we dropped.
        // For minimum-compile, this is a no-op stub.
    }
}

// SpecFromElem stub — real impl in dropped spec_from_elem module.
// Returns auto with no body referencing Vec — defer to instantiation.
struct SpecFromElem {
    template<typename T, typename A>
    static auto from_elem(T elem, std::size_t n, A alloc);
};

// SpecFromIter — forward declaration only; the definition (a generic
// push-loop fallback, patch_inject_spec_from_iter_fallback_def) follows
// `struct Vec`, which its return type names.
template<typename T, typename Iter>
struct SpecFromIter;

// SpecExtend — generic fallback mirroring the Rust default impl (push each
// item). The vendored port carried this as a hand edit: a no-op stub silently
// broke `Vec::extend` (`v.extend(4..=6)` did nothing — parity row `vec`).
template<typename T, typename Iter>
struct SpecExtend {
    template<typename V, typename I>
    static void spec_extend(V& vec, I iter) {
        if constexpr (!requires { iter.next(); }) {
            auto it = rusty::iter(iter);
            while (true) {
                auto next = it.next();
                if (next.is_none()) break;
                vec.push(rusty::detail::deref_if_pointer(next.unwrap()));
            }
        } else {
            while (true) {
                auto next = iter.next();
                if (next.is_none()) break;
                vec.push(rusty::detail::deref_if_pointer(next.unwrap()));
            }
        }
    }
};

// SpecCloneIntoVec stub — bridge for slice::clone_from_slice.
// Cannot nest in `namespace rusty::slice` because the module-scope
// `rusty::slice` would conflict with the header-level one.
// Patcher rewrites `::slice::SpecCloneIntoVec` / `slice::SpecCloneIntoVec`
// to bare `SpecCloneIntoVec` for these stubs.
struct SpecCloneIntoVec {
    // Rust `slice::clone_into(&self, target: &mut Vec<T>)`: reuse the
    // target's storage, clone the source elements across. The previous
    // empty-stub body made Vec::clone_from a silent no-op — cloned
    // IndexMaps kept full index tables over EMPTY entry vectors, which
    // then double-freed. Recovered from vendored commit 56fc9428 into
    // the patcher so a regen reproduces it (see memory
    // port-regen-pipeline-bitrot).
    template<typename Src, typename Dst>
    static void clone_into(Src src, Dst& dst) {
        auto s = rusty::as_slice(src);
        dst.clear();
        dst.reserve(s.size());
        for (size_t i = 0; i < s.size(); ++i) {
            dst.push(rusty::clone(s[i]));
        }
    }
};



