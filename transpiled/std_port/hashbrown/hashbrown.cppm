    ///     EntryRef::Occupied(_) => unreachable!(),
    /// };
    /// entry_v.insert(10);
    /// assert!(map["a"] == 10 && map.len() == 1);
    ///
    /// // Nonexistent key (insert and update)
    /// match map.entry_ref("b") {
    ///     EntryRef::Occupied(_) => unreachable!(),
    ///     EntryRef::Vacant(view) => {
    ///         let value = view.insert(2);
