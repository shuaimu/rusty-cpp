                }
            }
            std::tuple<K, V>& entry = table_shadow1.insert_entry(std::move(this->hash), std::make_tuple(std::move(key), std::move(value)), make_hasher(this->table.hash_builder));
            return std::get<1>(entry);
        }
        OccupiedEntry<K, V, S, A> insert_entry(V value) {
            auto elem = this->table.table.insert(std::move(this->hash), std::make_tuple(rusty::from_into<K>(this->key_field), std::move(value)), make_hasher(this->table.hash_builder));
