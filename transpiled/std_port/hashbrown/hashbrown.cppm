            if (!([](auto&& __self, auto&& __arg0) -> decltype(auto) { if constexpr (requires { rusty::detail::deref_if_pointer_like(std::forward<decltype(__self)>(__self)).equivalent(rusty::detail::deref_if_pointer_like(std::forward<decltype(__arg0)>(__arg0))); }) { return rusty::detail::deref_if_pointer_like(std::forward<decltype(__self)>(__self)).equivalent(rusty::detail::deref_if_pointer_like(std::forward<decltype(__arg0)>(__arg0))); } else if constexpr (requires { ::hashbrown::rusty_ext::equivalent(std::forward<decltype(__self)>(__self), std::forward<decltype(__arg0)>(__arg0)); }) { return ::hashbrown::rusty_ext::equivalent(std::forward<decltype(__self)>(__self), std::forward<decltype(__arg0)>(__arg0)); } else { return ::hashbrown::rusty_ext::equivalent(rusty::detail::deref_if_pointer_like(std::forward<decltype(__self)>(__self)), rusty::detail::deref_if_pointer_like(std::forward<decltype(__arg0)>(__arg0))); } })((this->key_field), key)) {
                {
