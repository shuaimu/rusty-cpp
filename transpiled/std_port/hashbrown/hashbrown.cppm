        Keys<K, V> keys() const {
            using namespace rustc_entry;
            return Keys<K, V>{.inner = this->iter()};
        }
        Values<K, V> values() const {
            using namespace rustc_entry;
            return Values<K, V>{.inner = this->iter()};
