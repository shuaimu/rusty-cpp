export template <class K>
class Equivalent {
public:
    virtual ~Equivalent() noexcept(false) {}
    virtual bool equivalent(const K& key) const = 0;
    Equivalent(const Equivalent&) = delete;
    Equivalent& operator=(const Equivalent&) = delete;
    Equivalent(Equivalent&&) = delete;
    Equivalent& operator=(Equivalent&&) = delete;
protected:
    Equivalent() = default;
};

template <class K, class U> class EquivalentAdapter;
template <class K, class U> class EquivalentAdapterRef;
template <class K, class U> class EquivalentAdapterRefMut;

namespace util {

    void cold_path();
    export bool likely(bool b);
    export bool unlikely(bool b);
    export template<typename T>
    std::add_pointer_t<T> invalid_mut(size_t addr);

    void cold_path() {
    }

    export bool likely(bool b) {
        if (b) {
            return true;
        } else {
            cold_path();
            return false;
        }
    }

    export bool unlikely(bool b) {
        if (b) {
            cold_path();
            return true;
        } else {
            return false;
        }
    }

    export template<typename T>
    std::add_pointer_t<T> invalid_mut(size_t addr) {
        // @unsafe
        {
            return rusty::mem::transmute<std::remove_cvref_t<decltype((std::move(addr)))>, std::add_pointer_t<T>>(std::move(addr));
        }
    }

}

