            using namespace rustc_entry;
            return HashMap<K, V, S, A>(std::move(hash_builder), raw::RawTable<std::tuple<K, V>, A>::new_in(std::move(alloc)));
        }
        static HashMap<K, V, S, A> with_capacity_and_hasher_in(size_t capacity, S hash_builder, A alloc) {
            using namespace rustc_entry;
            return HashMap<K, V, S, A>(std::move(hash_builder), raw::RawTable<std::tuple<K, V>, A>::with_capacity_in(std::move(capacity), std::move(alloc)));
        }
        const S& hasher() const {
            using namespace rustc_entry;
            return this->hash_builder;
        }
        size_t capacity() const {
            using namespace rustc_entry;
            return this->table.capacity();
