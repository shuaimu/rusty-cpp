}


namespace error {
    Source Source::clone() const {
        using Item = typename Source::Item;
        return {.current = rusty::clone(this->current)};
    }
}

namespace error {
    rusty::fmt::Result Source::fmt(rusty::fmt::Formatter& f) const {
        using Item = typename Source::Item;
        return f.debug_struct_field1_finish("Source", "current", &this->current);
    }
}

namespace error {
    rusty::Option<const void*&> Source::next() {
        using Item = typename Source::Item;
        auto current = this->current;
        this->current = rusty::Option<const void*&>{rusty::None};  // PATCH e3: chain walk truncated
        return std::move(current);
    }
}

namespace error {
    std::tuple<size_t, rusty::Option<size_t>> Source::size_hint() const {
        using Item = typename Source::Item;
        if (this->current.is_some()) {
            return std::make_tuple(static_cast<size_t>(1), rusty::Option<size_t>{rusty::None});
        } else {
            return std::make_tuple(static_cast<size_t>(0), rusty::Option<size_t>(static_cast<size_t>(0)));
        }
    }
}

namespace error {
    rusty::fmt::Result Backtrace::fmt(rusty::fmt::Formatter& f) const {
        return f.write_str(std::string_view("<backtrace unavailable>"));
    }
}

namespace hash::random {
        DefaultHasher DefaultHasher::clone() const {
            return {rusty::clone(this->_0)};
        }
}

namespace hash::random {
        rusty::fmt::Result DefaultHasher::fmt(rusty::fmt::Formatter& f) const {
            return f.debug_tuple_field1_finish("DefaultHasher", &this->_0);
        }
}

namespace hash::random {
        constexpr DefaultHasher DefaultHasher::new_() {
            return DefaultHasher(rusty::hash::SipHasher::new_with_keys(0, 0));
        }
}

namespace hash::random {
        DefaultHasher DefaultHasher::default_() {
            return DefaultHasher::new_();
        }
}

namespace hash::random {
        void DefaultHasher::write_(std::span<const uint8_t> msg) {
            this->_0.write(msg);
        }
}

namespace hash::random {
        uint64_t DefaultHasher::finish() const {
            return this->_0.finish();
        }
}

namespace hash::random {
        RandomState RandomState::clone() const {
            using Hasher = typename RandomState::Hasher;
            return {.k0 = rusty::clone(this->k0), .k1 = rusty::clone(this->k1)};
        }
}

namespace hash::random {
        RandomState RandomState::new_() {
            using Hasher = typename RandomState::Hasher;
            return RandomState{.k0 = static_cast<uint64_t>(11400714819323198485), .k1 = static_cast<uint64_t>(7640891576956012809)};
        }
}

namespace hash::random {
        DefaultHasher RandomState::build_hasher() const {
            using Hasher = typename RandomState::Hasher;
            return DefaultHasher(rusty::hash::SipHasher::new_with_keys(this->k0, this->k1));
        }
}

namespace hash::random {
        RandomState RandomState::default_() {
            using Hasher = typename RandomState::Hasher;
            return RandomState::new_();
        }
}

namespace hash::random {
        rusty::fmt::Result RandomState::fmt(rusty::fmt::Formatter& f) const {
            using Hasher = typename RandomState::Hasher;
            return f.debug_struct("RandomState").finish_non_exhaustive();
        }
}

