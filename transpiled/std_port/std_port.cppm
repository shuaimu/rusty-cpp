namespace error {

    export template<typename T>
    rusty::Option<T> request_value(const auto& _err) {
        return rusty::Option<T>{rusty::None};
    }

    export template<typename T>
    rusty::Option<const T&> request_ref(const auto& _err) {
        return rusty::Option<const T&>{rusty::None};
