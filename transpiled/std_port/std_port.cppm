    namespace random {

        export struct DefaultHasher;
        export struct RandomState;

        // Rust-only: using std::hash::BuildHasher;
        // Rust-only: using std::hash::Hasher;

        // Rust-only: using SipHasher13 = rusty::hash::SipHasher;

        using rusty::Cell;


        /// The default [`Hasher`] used by [`RandomState`].
        ///
        /// The internal algorithm is not specified, and so it and its hashes should
        /// not be relied upon over releases.
        export struct DefaultHasher {
            rusty::hash::SipHasher _0;

            DefaultHasher clone() const;
            rusty::fmt::Result fmt(rusty::fmt::Formatter& f) const;
            static constexpr DefaultHasher new_();
            static DefaultHasher default_();
            void write_(std::span<const uint8_t> msg);
            uint64_t finish() const;
        };

        /// `RandomState` is the default state for [`HashMap`] types.
        ///
        /// A particular instance `RandomState` will create the same instances of
        /// [`Hasher`], but the hashers created by two different `RandomState`
        /// instances are unlikely to produce the same result for the same values.
        ///
        /// [`HashMap`]: crate::collections::HashMap
        ///
        /// # Examples
        ///
        /// ```
        /// use std::collections::HashMap;
        /// use std::hash::RandomState;
        ///
        /// let s = RandomState::new();
        /// let mut map = HashMap::with_hasher(s);
        /// map.insert(1, 2);
        /// ```
        export struct RandomState {
            using Hasher = DefaultHasher;
            uint64_t k0;
            uint64_t k1;

            RandomState clone() const;
            static RandomState new_();
            DefaultHasher build_hasher() const;
            static RandomState default_();
            rusty::fmt::Result fmt(rusty::fmt::Formatter& f) const;
        };

    }

    export using random::DefaultHasher;
    export using random::RandomState;

}

