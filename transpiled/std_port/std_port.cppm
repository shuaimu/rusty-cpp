inline rusty::String to_ascii_uppercase(std::string_view s) {
std::string out(s);
for (auto& c : out) if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 32);
return rusty::String::from(out);
}
inline rusty::String to_ascii_lowercase(std::string_view s) {
std::string out(s);
for (auto& c : out) if (c >= 'A' && c <= 'Z') c = static_cast<char>(c + 32);
