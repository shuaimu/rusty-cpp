        rusty::fmt::Result write_str(std::string_view s) {
            for (auto&& _for_item : rusty::for_in(rusty::enumerate(rusty::str_runtime::split(s, U'\n')))) {
                auto&& i = rusty::detail::deref_if_pointer(std::get<0>(rusty::detail::deref_if_pointer(_for_item)));
                auto&& line = rusty::detail::deref_if_pointer(std::get<1>(rusty::detail::deref_if_pointer(_for_item)));
