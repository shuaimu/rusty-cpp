return rusty::String::from(s);
}
std::string out(s);
std::size_t pos = 0;
while ((pos = out.find(from, pos)) != std::string::npos) {
out.replace(pos, from.size(), to);
pos += to.size();
}
return rusty::String::from(out);
}
