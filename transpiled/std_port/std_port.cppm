            export template<typename K, typename V, typename A = rusty::alloc::Global>
                requires (rusty::alloc::Allocator<A>)
            struct OccupiedEntry {
                hashbrown::hash_map::RustcOccupiedEntry<K, V, A> base;

                rusty::fmt::Result fmt(rusty::fmt::Formatter& f) const {
                    return f.debug_struct("OccupiedEntry").field("key", this->key()).field("value", this->get()).finish_non_exhaustive();
                }
                const K& key() const {
                    return this->base.key();
                }
                std::tuple<K, V> remove_entry() {
                    return this->base.remove_entry();
                }
                const V& get() const {
                    return this->base.get();
                }
                V& get_mut() {
                    return this->base.get_mut();
                }
                V& into_mut() {
                    return this->base.into_mut();
                }
                V insert(V value) {
                    return this->base.insert(std::move(value));
                }
                V remove() {
                    return this->base.remove();
                }
            };

            /// A view into a vacant entry in a `HashMap`.
            /// It is part of the [`Entry`] enum.
            export template<typename K, typename V, typename A = rusty::alloc::Global>
                requires (rusty::alloc::Allocator<A>)
            struct VacantEntry {
                hashbrown::hash_map::RustcVacantEntry<K, V, A> base;

                rusty::fmt::Result fmt(rusty::fmt::Formatter& f) const {
                    return f.debug_tuple("VacantEntry").field(this->key()).finish();
                }
                const K& key() const {
                    return this->base.key();
                }
                K into_key() {
                    return this->base.into_key();
                }
                V& insert(V value) {
                    return this->base.insert(std::move(value));
                }
                OccupiedEntry<K, V, A> insert_entry(V value) {
                    auto base = this->base.insert_entry(std::move(value));
                    return OccupiedEntry<K, V, A>{.base = std::move(base)};
                }
            };

