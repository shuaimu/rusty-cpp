return Entry<K, V, A>{Entry_Occupied<K, V, A>{entry}}; }(); } if (rusty::detail::variant_index(rusty::detail::deref_if_pointer(_m)) == 1) { auto&& entry = rusty::detail::deref_if_pointer(std::get<1>(rusty::detail::deref_if_pointer(_m))._0); return Entry<K, V, A>{Entry_Vacant<K, V, A>{entry}}; } return [&]() -> Entry<K, V, A> { rusty::intrinsics::unreachable(); }(); }();
