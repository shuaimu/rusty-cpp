template<typename T>
struct ArcInner {
    rusty::sync::atomic::detail::Atomic<size_t> strong;
    rusty::sync::atomic::detail::Atomic<size_t> weak;
    T data;
    [[no_unique_address]] alignas(2) rusty::Unit _rusty_align_anchor_{};

};

/// Helper type to allow accessing the reference counts without
/// making any assertions about the data field.
struct WeakInner {
    const rusty::sync::atomic::detail::Atomic<size_t>& weak;
    const rusty::sync::atomic::detail::Atomic<size_t>& strong;
};

/// Struct to hold the static `ArcInner` used for empty `Arc<str/CStr/[T]>` as
/// returned by `Default::default`.
///
/// Layout notes:
/// * `repr(align(16))` so we can use it for `[T]` with `align_of::<T>() <= 16`.
/// * `repr(C)` so `inner` is at offset 0 (and thus guaranteed to actually be aligned to 16).
/// * `[u8; 1]` (to be initialized with 0) so it can be used for `Arc<CStr>`.
struct SliceArcInnerForStatic {
    ArcInner<std::array<uint8_t, 1>> inner;
