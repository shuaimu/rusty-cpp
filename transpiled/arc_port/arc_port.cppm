// patcher: is_send/is_sync specializations for Arc<T, A> / Weak<T, A>
namespace rusty {
    template<typename T, typename A>
    struct is_send<::rusty::port::sync::Arc<T, A>>
        : std::bool_constant<is_send<T>::value && is_sync<T>::value> {};
    template<typename T, typename A>
