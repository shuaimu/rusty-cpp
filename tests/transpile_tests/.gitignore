# Ignore downloaded crate source files
# Only track the test script and expected outputs
*/src/
*/Cargo.toml
*/Cargo.lock
*/.git/
*/target/

# Transpiled output
*/cpp_out/
*.cppm

# Compiled binaries
compile_test*
!compile_test*.cpp

# But track these:
!run_tests.sh
!README.md
!.gitignore

# Track committed cpp:: interop fixture assets
!cpp_module_interop/
!cpp_module_interop/Cargo.toml
!cpp_module_interop/src/
!cpp_module_interop/src/lib.rs
!cpp_module_interop/cpp_module_index.toml
!cpp_module_interop/cpp_modules/
!cpp_module_interop/cpp_modules/custom.math.cppm

# Track committed cpp::std complex fixture assets
!cpp_std_complex/
!cpp_std_complex/Cargo.toml
!cpp_std_complex/src/
!cpp_std_complex/src/lib.rs
!cpp_std_complex/cpp_module_index.toml

# Track the committed local `vec` parity-test crate (hand-written, not cloned)
!vec/
!vec/Cargo.toml
!vec/src/
!vec/src/lib.rs
# Track the committed local `btree` parity-test crate (hand-written, not cloned)
!btree/
!btree/Cargo.toml
!btree/src/
!btree/src/lib.rs
# Track the committed local `trait_probes_*` parity-test crates (hand-written,
